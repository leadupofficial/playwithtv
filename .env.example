# Copy to .env. No secrets are committed; generate your own values.
PORT=8080
# Public URL the QR code points phones to (must be reachable from the phones).
PUBLIC_URL=https://play.example.com
# Comma-separated origins allowed to open WebSockets / call the API.
ALLOWED_ORIGINS=https://play.example.com
# Optional: durable storage and shared ephemeral state. Without them the server runs in memory.
DATABASE_URL=postgres://scp:change-me@localhost:5432/scp
REDIS_URL=redis://localhost:6379
# Admin console access: at least 32 random characters, e.g. `openssl rand -hex 24`. Required in production.
ADMIN_TOKEN=replace-with-a-long-random-string
# How many reverse proxies are in front of the app (nginx/Caddy = 1). Client IPs are only trusted from that hop.
TRUST_PROXY_HOPS=1
