{
  "id": "/tv",
  "name": "Scan · Connect · Play TV",
  "short_name": "Play With TV",
  "description": "Party games on your TV. Phones join by scanning the code.",
  "start_url": "/tv?source=app",
  "scope": "/",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "landscape",
