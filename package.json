{
  "name": "playwithtv",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @playwithtv/server --filter @playwithtv/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "playwright test",
    "start": "pnpm --filter @playwithtv/server start",
    "docs:catalogue": "pnpm --filter @playwithtv/server exec tsx ../../scripts/catalogue-doc.ts",
    "hooks:install": "git config core.hooksPath scripts/git-hooks",
    "e2e:prod": "playwright test -c playwright.prod.config.ts",
    "ship": "sh scripts/deploy.sh",
    "content:check": "pnpm --filter @playwithtv/server exec tsx ../../scripts/content-check.ts",
    "assets:sprites": "blender -b --factory-startup -P tools/blender/render_sprites.py --",
    "assets:backdrop": "blender -b --factory-startup -P tools/blender/render_backdrop.py --",
    "assets:glb": "blender -b --factory-startup -P tools/blender/export_glb.py --"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "description": "Play With TV: party games on your TV with phones as motion controllers.",
  "author": "Leadup Technologies \u2013 Abishek Sivakumar"
}
