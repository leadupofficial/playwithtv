#!/bin/sh
# Blocks any commit whose staged changes contain a secret (API keys, tokens, private keys, passwords).
# Enable once per clone: pnpm hooks:install
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (macOS: brew install gitleaks). Refusing to commit unscanned." >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner
